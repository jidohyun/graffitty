extends "../../../../replay/replay.gd"

func command(combo: String) -> void:
	await keys("ctrl+a")
	check(host.prefix_commands.active, "Ctrl+A arms the prefix")
	await keys(combo)
	await owner_at_rest()
	check(not host.prefix_commands.active, "Command leaves prefix mode")

## Shifted punctuation is bound by the character the layout types.
func typed_command(code: Key, character: String) -> void:
	await keys("ctrl+a")
	check(host.prefix_commands.active, "Ctrl+A arms the prefix")
	await _key(code, character.unicode_at(0), {"shift": true}, "⇧" + character)
	await owner_at_rest()
	check(not host.prefix_commands.active, "Command leaves prefix mode")

func play() -> void:
	await open_tabs(10)
	await select_tab(0)
	await say("Arm the prefix: the selected tab turns amber")
	await keys("ctrl+a")
	var button: Button = tab_button(0)
	check(button.self_modulate != Color.WHITE, "Active prefix changes the selected tab color")
	await keys("1")
	check(host.command_line_open() and host.command_line.line.text == "1", "A digit opens the command line with that digit")
	check(host.workspace_layout.active == host.workspace_layout.tabs[0].id, "First digit waits for Enter")
	await type("0")
	check(host.command_line.line.text == "10", "The line collects a multi-digit tab number")
	await keys("enter")
	check(host.workspace_layout.active == host.workspace_layout.tabs[9].id, "10 Enter selects tab ten")
	check(not host.prefix_commands.active and not host.command_line_open(), "Tab selection closes the line and the prefix")
	await keys("cmd+1")
	check(host.workspace_layout.active == host.workspace_layout.tabs[0].id, "Cmd+1 still selects tab one immediately")
	await keys("cmd+9")
	check(host.workspace_layout.active == host.workspace_layout.tabs[9].id, "Cmd+9 selects the last tab, not the ninth")
	await keys("cmd+1")
	await say("Create a tab, then split right and below")
	var count: int = host.workspace_layout.tabs.size()
	await command("c")
	check(host.workspace_layout.tabs.size() == count + 1, "Prefix C creates a workspace tab")
	var first: String = host.pane_focus
	await command("backslash")
	var right: String = host.pane_focus
	check(first != right, "Prefix backslash creates a right pane")
	await command("h")
	check(host.pane_focus == first, "Prefix H focuses left")
	await command("l")
	check(host.pane_focus == right, "Prefix L focuses right")
	await command("minus")
	var below: String = host.pane_focus
	check(below != right, "Prefix minus creates a bottom pane")
	await command("k")
	check(host.pane_focus == right, "Prefix K focuses up")
	await command("j")
	check(host.pane_focus == below, "Prefix J focuses down")
	await say("Cancel and edit prefix input without sending it to the shell")
	await keys("ctrl+a")
	await keys("9")
	await keys("backspace")
	check(host.command_line_open() and host.command_line.line.text.is_empty(), "Backspace edits the number")
	await keys("escape")
	check(not host.prefix_commands.active and not host.command_line_open(), "Escape cancels")
	check(tab_button(host.workspace_layout.tabs.size() - 1).self_modulate == Color.WHITE, "Cancel restores the tab color")
	await keys("ctrl+a")
	await keys("9")
	await type("9")
	await keys("enter")
	check(host.pane_focus == below, "Out-of-range tab number leaves focus unchanged")
	check(host.command_line_open() and host.command_line.model.status() == "No matches", "The line stays open and says why")
	await keys("escape")
	await keys("ctrl+a")
	await keys("q")
	check(not host.prefix_commands.active, "Unbound key cancels without forwarding")
	var rects: Dictionary = host.workspace_view.pane_rects
	await typed_command(KEY_BACKSLASH, "|")
	var last: String = host.pane_focus
	check(last != below and rects[last].get_center().x < rects[below].get_center().x, "Shifted pipe splits left")
	await typed_command(KEY_MINUS, "_")
	check(host.pane_focus != last and rects[host.pane_focus].get_center().y < rects[last].get_center().y, "Shifted underscore splits above")
	await keys("ctrl+a")
	root.focus_exited.emit()
	check(not host.prefix_commands.active, "Window focus loss cancels prefix")
	# User bindings use the same application-level settings on every world.
	host.prefix_commands.settings.key = KEY_B | KEY_MASK_CTRL
	host.prefix_commands.settings.bindings[KEY_X] = "NewTab"
	count = host.workspace_layout.tabs.size()
	await keys("ctrl+b")
	await keys("x")
	await owner_at_rest()
	check(host.workspace_layout.tabs.size() == count + 1, "Custom prefix and action binding work")
