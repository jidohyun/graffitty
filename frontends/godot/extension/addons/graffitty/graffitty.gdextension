[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
# Hot-reloading this extension crashes the editor (live terminal threads);
# false makes every engine reload path skip it, so rebuilds apply on restart.
reloadable = false

[libraries]
linux.editor.x86_64 = "res://addons/graffitty/bin/libgraffitty.linux.x86_64.so"
macos.editor = "res://addons/graffitty/bin/libgraffitty.macos.dylib"
windows.editor.x86_64 = "res://addons/graffitty/bin/libgraffitty.windows.x86_64.dll"
