; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Graffitty"
run/max_fps=120
run/main_scene="res://scenes/terminal.tscn"
run/main_scene.android="res://scenes/remote_manager.tscn"
run/main_scene.ios="res://scenes/remote_manager.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/graffitty"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/exports/graffitty-icon.png"
config/icon.linux="res://assets/branding/exports/graffitty-icon-macos.png"
config/icon.macos="res://assets/branding/exports/graffitty-icon-macos.png"
config/icon.windows="res://assets/branding/exports/graffitty-icon-macos.png"
config/macos_native_icon="res://assets/branding/exports/graffitty.icns"
config/windows_native_icon="res://assets/branding/exports/graffitty.ico"
config/custom_user_dir_name.linux="godot/app_userdata/graffitty"
config/custom_user_dir_name.bsd="godot/app_userdata/graffitty"

[autoload]

GpuStartup="*res://graffitty/GpuStartup.gd"
Localization="*res://config/Localization.gd"
DiagnosticService="*res://scenes/DiagnosticService.gd"
TerminalApplication="*res://scenes/TerminalApplication.gd"

[audio]

; Chromium owns media playback, and dictation opens native capture on demand
; (AAudio on Android). Agent alerts also open native output only while playing.
; An idle Godot output device plays silence: it prevents
; system sleep on macOS and kept a tablet's audio server busy on a core.
driver/driver="Dummy"

[debug]

file_logging/enable_file_logging.pc=false
settings/gdscript/always_track_call_stacks=true

[display]

window/energy_saving/keep_screen_on=false
; Swappy returns VK_INCOMPLETE on Android's emulator before the first frame.
; Keep Mobile/Vulkan and use its normal presentation path instead.
window/frame_pacing/android/enable_frame_pacing=false
window/handheld/orientation.android=6
window/handheld/orientation.ios=6

window/size/borderless.graffitty_linux_frame=true
window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/per_pixel_transparency/allowed.android=false
window/per_pixel_transparency/allowed.ios=false

[editor_plugins]

enabled=PackedStringArray()
enabled.linux=PackedStringArray("res://graffitty/linux_export/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[rendering]

; Desktop export presets select S3TC even when the build machine uses ARM/Mesa.
textures/vram_compression/import_s3tc_bptc.linux=true
textures/vram_compression/import_s3tc_bptc.windows=true
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method.mobile="mobile"

rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_d3d12.windows=false
lights_and_shadows/use_physical_light_units=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
camera/depth_of_field/depth_of_field_bokeh_quality=1
; Use a circular aperture for native scenery depth of field.
camera/depth_of_field/depth_of_field_bokeh_shape=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
