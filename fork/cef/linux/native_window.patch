+
+void CefVideoConsumerOSR::RefreshUntilSized() {
+  if (!active_ || resize_refresh_timer_.IsRunning())
+    return;
+  // A refresh issued while an old-size frame is in flight can be coalesced.
+  // Static pages need no further damage, so retry until a frame acknowledges
+  // the requested size. Stop immediately on success, hide, or destruction.
+  resize_refresh_timer_.Start(
+      FROM_HERE, base::Milliseconds(100),
+      base::BindRepeating([](CefVideoConsumerOSR* self) {
+        self->video_capturer_->RequestRefreshFrame();
+      }, base::Unretained(this)));
 }
 
