+void DesktopWindowTreeHostPlatform::SetOffscreenCapture(bool enabled) {
+  if (offscreen_capture_ == enabled)
+    return;
+  CHECK(compositor());
+  const bool was_visible = compositor()->IsVisible();
+  compositor()->SetVisible(false);
+  // Release synchronously retires the old output surface before the native
+  // surface is unmapped or reused. The new sink retains GPU compositing.
+  compositor()->ReleaseAcceleratedWidget();
+  offscreen_capture_ = enabled;
+  if (enabled)
+    platform_window()->Hide();
+  compositor()->SetAcceleratedWidget(enabled ? gfx::kNullAcceleratedWidget
+                                            : GetAcceleratedWidget());
+  compositor()->SetVisible(was_visible);
+}
